# cmake/VoidMaizApp.cmake — one call that turns a portable maiz::App into
# whatever this platform runs (okf/concepts/portable-apps.md).
#
#   maiz_add_app(my_app
#     SOURCES   src/my_app.cpp ...         # defines maiz::create_app()
#     NAME      "My App"                   # what a person sees
#     BUNDLE_ID org.example.myapp          # reverse-DNS; the iOS bundle id, the data folder's name
#     VERSION   1.2.0
#     RESOURCES assets/fonts/Lato.ttf ...  # shipped inside the app (Device::read_asset)
#     IOS_PLIST_EXTRA path/to/extra.plist  # optional: keys merged into Info.plist (usage strings)
#   )
#
# Desktop: an executable (`my_app --device iphone-16` previews it as a phone).
# Android: lib<my_app>.so for a NativeActivity whose shell is the library's;
#          the host's build_apk script packages it, as before.
# iOS:     a .app bundle with an Info.plist and a privacy manifest generated
#          from templates in this folder. Built with CMake's Xcode generator.
#
# The function is deliberately small. What a store needs that cannot be
# generated (icons, signing, the App Store's privacy answers) is listed in
# okf/concepts/ios.md rather than guessed at here.

set(MAIZ_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(maiz_add_app target)
  cmake_parse_arguments(A "" "NAME;BUNDLE_ID;VERSION;IOS_PLIST_EXTRA" "SOURCES;RESOURCES" ${ARGN})
  if(NOT A_NAME)
    set(A_NAME "${target}")
  endif()
  if(NOT A_BUNDLE_ID)
    set(A_BUNDLE_ID "org.voidmaiz.${target}")
  endif()
  if(NOT A_VERSION)
    set(A_VERSION "0.1.0")
  endif()

  # Who the app is, readable by the shell at run time on every platform.
  set(_info "${CMAKE_CURRENT_BINARY_DIR}/${target}_appinfo.cpp")
  file(WRITE "${_info}"
    "// generated by maiz_add_app (cmake/VoidMaizApp.cmake)\n"
    "extern \"C\" const char* const maiz_app_name = \"${A_NAME}\";\n"
    "extern \"C\" const char* const maiz_app_id = \"${A_BUNDLE_ID}\";\n"
    "extern \"C\" const char* const maiz_app_version = \"${A_VERSION}\";\n")

  if(ANDROID)
    add_library(${target} SHARED ${A_SOURCES} "${_info}")
    target_link_libraries(${target} PRIVATE voidmaiz_app)
    # the NativeActivity glue's entry point must survive the link
    target_link_options(${target} PRIVATE "-u" "ANativeActivity_onCreate")
  elseif(IOS)
    add_executable(${target} MACOSX_BUNDLE ${A_SOURCES} "${_info}" ${A_RESOURCES}
      "${MAIZ_CMAKE_DIR}/ios/PrivacyInfo.xcprivacy")
    target_link_libraries(${target} PRIVATE voidmaiz_app)
    set(MAIZ_IOS_NAME "${A_NAME}")
    set(MAIZ_IOS_BUNDLE_ID "${A_BUNDLE_ID}")
    set(MAIZ_IOS_VERSION "${A_VERSION}")
    set(MAIZ_IOS_EXECUTABLE "${target}")
    set(MAIZ_IOS_PLIST_EXTRA "")
    if(A_IOS_PLIST_EXTRA)
      file(READ "${A_IOS_PLIST_EXTRA}" MAIZ_IOS_PLIST_EXTRA)
    endif()
    set(_plist "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist")
    configure_file("${MAIZ_CMAKE_DIR}/ios/Info.plist.in" "${_plist}" @ONLY)
    set_source_files_properties(${A_RESOURCES} "${MAIZ_CMAKE_DIR}/ios/PrivacyInfo.xcprivacy"
      PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    set_target_properties(${target} PROPERTIES
      MACOSX_BUNDLE_INFO_PLIST "${_plist}"
      XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${A_BUNDLE_ID}"
      XCODE_ATTRIBUTE_INFOPLIST_FILE "${_plist}"
      XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2"   # iPhone and iPad
      XCODE_ATTRIBUTE_IPHONEOS_DEPLOYMENT_TARGET "16.0"
      XCODE_ATTRIBUTE_CLANG_ENABLE_OBJC_ARC "YES"
      XCODE_ATTRIBUTE_CURRENT_PROJECT_VERSION "${A_VERSION}"
      XCODE_ATTRIBUTE_MARKETING_VERSION "${A_VERSION}")
  else()
    add_executable(${target} ${A_SOURCES} "${_info}")
    target_link_libraries(${target} PRIVATE voidmaiz_app)
    if(A_RESOURCES)
      # beside the binary, under assets/, where Device::read_asset looks
      foreach(_r ${A_RESOURCES})
        get_filename_component(_n "${_r}" NAME)
        add_custom_command(TARGET ${target} POST_BUILD
          COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:${target}>/assets"
          COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/${_r}"
                  "$<TARGET_FILE_DIR:${target}>/assets/${_n}")
      endforeach()
    endif()
  endif()
endfunction()
