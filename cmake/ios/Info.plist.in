<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by maiz_add_app (cmake/VoidMaizApp.cmake) from cmake/ios/Info.plist.in. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@MAIZ_IOS_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@MAIZ_IOS_EXECUTABLE@</string>
	<key>CFBundleIdentifier</key>
	<string>@MAIZ_IOS_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@MAIZ_IOS_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@MAIZ_IOS_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@MAIZ_IOS_VERSION@</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- No storyboard: an empty launch screen is the window background colour. -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- The scene life cycle. Apple announced with iOS 26 that apps built
	     against the next SDK must adopt it, so the shell starts there rather
	     than migrating later. MaizSceneDelegate is in src/shell/shell_ios.mm. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>MaizSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The shell links CoreLocation (voidmaiz/location.hpp), so App Store
	     Connect refuses an upload without a purpose string even if the app
	     never asks. This default is honest for any app that asks only from a
	     tap, which is the only way location.hpp lets it ask. Override it with
	     IOS_PLIST_EXTRA to say what YOUR app does with it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>@MAIZ_IOS_NAME@ uses your location only when you ask it to show where you are.</string>
	<!-- No encryption beyond what iOS itself provides (HTTPS). Revisit when
	     networking (Reticulum, libsodium) is built for iOS: that is
	     non-exempt-looking cryptography and needs the export answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
@MAIZ_IOS_PLIST_EXTRA@
</dict>
</plist>
